# ===================================================================
# SlimBox 部署环境变量配置文件 (.env)
# 存储分离架构规范：
# 1. 系统配置与 SQLite 数据库持久化在 /opt 目录下 (系统盘，轻量级，保护数据一致性)
# 2. 上传、转码与制品的视频文件持久化在 /mnt 目录下 (外置 USB 硬盘，大容量，防爆系统盘)
# ===================================================================

# 1. 容器镜像（按硬件架构与显卡选择对应的专属 Tag）：
# - arm64          : 专供 ARM64 架构（斐讯 N1、树莓派、电视盒子，纯 CPU 软编极致轻量版，推荐 N1 使用）
# - intel          : 专供 Intel 4~14 代核显/独显 (N100、i3/i5/i7、Arc，集成 QSV/VAAPI 驱动)
# - amd            : 专供 AMD 锐龙 APU 核显 (5600G/7840HS/8845H) 及 Radeon 独显 (集成 Mesa VAAPI)
# - nvidia         : 专供 NVIDIA 独立显卡（需配合 nvidia-container-toolkit 启用 NVENC）
# - latest/standard: 全功能通用版（x86 下集成 Intel + AMD 双驱动，开箱即用推荐）
IMAGE_TAG=crpi-tyyqcg8a2rpatesk.cn-shanghai.personal.cr.aliyuncs.com/zixidaxian/slimbox:latest

# 2. 宿主机对外端口映射 (N1 生产机端口: 8081)
WEB_PORT=8081

# 3. 宿主机系统盘配置与数据库挂载路径 (/opt 子目录)
# 存放内容：slimbox.db (任务数据库、预设参数、系统设置、API Key/密码凭据)
CONFIG_DATA_PATH=/opt/docker/slimbox/data

# 4. 宿主机外置 USB 硬盘视频存储路径 (/mnt 子目录)
# 存放内容：
#   - /mnt/usbdata/slimbox/uploads (上传源视频、大文件分片流式上传临时缓存 uploads/temp)
#   - /mnt/usbdata/slimbox/outputs (转码中间产物 *.part、压缩完毕的最终成品视频)
VIDEO_STORAGE_PATH=/mnt/usbdata/slimbox

# 5. 容器时区设置
TZ=Asia/Shanghai

# 6. Docker 容器日志滚动限制
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3

# 7. 安全鉴权开关 (双模架构)
# false: 免密模式 (路线 A, 适合家庭内网/单人环境)
# true:  安全鉴权模式 (路线 C, 启用管理员密码、PIN 初始化向导、Token 鉴权与 RBAC)
SLIMBOX_AUTH_ENABLED=true

# 8. 管理员主密码 (可选预设)
# 若留空且 SLIMBOX_AUTH_ENABLED=true，服务首次启动将在终端输出 6 位一次性 PIN 码供 Web 设密向导使用
SLIMBOX_ADMIN_PASSWORD=
